export component StudioEditor inherits Rectangle {
    width: 900px;
    height: 600px;
    background: #080c14;
    border-radius: 20px;
    border-width: 1.5px;
    border-color: #22d45e;
    drop-shadow-blur: 40px;
    drop-shadow-color: #22d45e30;

    // Core state
    in-out property <string> active-tool: "arrow";
    in-out property <string> active-color: "#FF3B30";
    in-out property <int> stroke-size: 2;   // 1=thin, 2=normal, 3=thick
    in-out property <image> canvas-image;
    in-out property <bool> has-canvas-image: false;
    in-out property <bool> watermark-active: true;
    in-out property <string> status-text: "Select a tool and draw on the canvas";
    in-out property <int> current-step: 1;  // next step number to place

    // Live drag preview state
    in-out property <bool> drag-active: false;
    in-out property <int> drag-x1;
    in-out property <int> drag-y1;
    in-out property <int> drag-x2;
    in-out property <int> drag-y2;

    // Callbacks
    callback close-editor();
    callback select-tool(string);
    callback select-color(string);
    callback select-stroke(int);
    callback open-file-dialog();
    callback copy-clipboard();
    callback undo-annotation();
    callback clear-annotations();
    callback apply-annotation(string, string, int, int, int, int, int);
    callback save-editor-snapshot();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ── TOP HEADER BAR ────────────────────────────────────────────────────
        Rectangle {
            height: 50px;
            background: #0b1120;
            border-radius: 0px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                // Left: Brand + subtitle
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "🎨";
                        font-size: 18px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "SHOWCASE CREATIVE STUDIO";
                            font-size: 11px; font-weight: 900; color: #f1f5f9;
                        }
                        Text {
                            text: root.status-text;
                            font-size: 9px; color: #64748b;
                        }
                    }

                    // Step counter badge
                    if (root.active-tool == "step") : Rectangle {
                        height: 24px;
                        background: #22d45e;
                        border-radius: 12px;

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: center;
                            Text {
                                text: "Next: ①②③  Step " + root.current-step;
                                font-size: 9px; font-weight: 900; color: #000000;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Right: Action Buttons
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    wm_toggle := Rectangle {
                        height: 30px;
                        background: root.watermark-active ? #3b82f6 : (wm_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.watermark-active ? #3b82f6 : #334155;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: center;
                            Text {
                                text: root.watermark-active ? "🏷️ Brand ON" : "🏷️ Brand OFF";
                                font-size: 9px; font-weight: 800;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }
                        wm_t := TouchArea { clicked => { root.watermark-active = !root.watermark-active; } }
                    }

                    open_hdr := Rectangle {
                        height: 30px;
                        background: open_hdr_t.has-hover ? #1e293b : #161e2e;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #38bdf8;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: center;
                            Text {
                                text: "📂 OPEN";
                                font-size: 9px; font-weight: 800; color: #38bdf8;
                                vertical-alignment: center;
                            }
                        }
                        open_hdr_t := TouchArea { clicked => { root.open-file-dialog(); } }
                    }

                    close_hdr := Rectangle {
                        width: 30px; height: 30px;
                        background: close_hdr_t.has-hover ? #1e293b : #161e2e;
                        border-radius: 15px;
                        animate background { duration: 100ms; }

                        Text {
                            text: "✕";
                            font-size: 14px; color: #94a3b8;
                            x: (parent.width - self.width)/2;
                            y: (parent.height - self.height)/2;
                        }
                        close_hdr_t := TouchArea { clicked => { root.close-editor(); } }
                    }
                }
            }
        }

        // ── CANVAS AREA (fills all remaining space) ───────────────────────────
        canvas_box := Rectangle {
            background: #050810;
            border-radius: 0px;
            border-width: 0px;

            // Image content
            if (root.has-canvas-image) : Image {
                source: root.canvas-image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Beautiful empty state card
            if (!root.has-canvas-image) : Rectangle {
                width: 320px; height: 200px;
                background: #0f1623;
                border-radius: 20px;
                border-width: 1px;
                border-color: #1e293b;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                VerticalLayout {
                    alignment: center; spacing: 12px;
                    Text { text: "✨"; font-size: 40px; horizontal-alignment: center; }
                    Text {
                        text: "No image loaded";
                        font-size: 14px; font-weight: 800; color: #f1f5f9;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Open a file or take a snapshot\nto start annotating";
                        font-size: 11px; color: #64748b;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 34px; width: 160px;
                        x: (parent.width - self.width) / 2;
                        background: open_empty_t.has-hover ? #16a34a : #22d45e;
                        border-radius: 10px;
                        animate background { duration: 100ms; }
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "📂 Open Image";
                                font-size: 11px; font-weight: 900; color: #000000;
                                vertical-alignment: center;
                            }
                        }
                        open_empty_t := TouchArea { clicked => { root.open-file-dialog(); } }
                    }
                }
            }

            // ── LIVE DRAG PREVIEW OVERLAY ──────────────────────────────────────
            if (root.drag-active && (root.active-tool == "rect" || root.active-tool == "blur" || root.active-tool == "spotlight")) : Rectangle {
                x: (root.drag-x1 < root.drag-x2 ? root.drag-x1 : root.drag-x2) * 1px;
                y: (root.drag-y1 < root.drag-y2 ? root.drag-y1 : root.drag-y2) * 1px;
                width: (root.drag-x2 - root.drag-x1 > 0 ? root.drag-x2 - root.drag-x1 : root.drag-x1 - root.drag-x2) * 1px;
                height: (root.drag-y2 - root.drag-y1 > 0 ? root.drag-y2 - root.drag-y1 : root.drag-y1 - root.drag-y2) * 1px;
                background: root.active-tool == "blur" ? #080c1460 : (root.active-tool == "spotlight" ? #000000a0 : transparent);
                border-width: 2px;
                border-color: root.active-tool == "blur" ? #22d45e : (root.active-tool == "spotlight" ? #ffffff : #3b82f6);
                border-radius: root.active-tool == "rect" ? 4px : 0px;
            }

            // Oval preview
            if (root.drag-active && root.active-tool == "oval") : Rectangle {
                x: (root.drag-x1 < root.drag-x2 ? root.drag-x1 : root.drag-x2) * 1px;
                y: (root.drag-y1 < root.drag-y2 ? root.drag-y1 : root.drag-y2) * 1px;
                width: (root.drag-x2 - root.drag-x1 > 0 ? root.drag-x2 - root.drag-x1 : root.drag-x1 - root.drag-x2) * 1px;
                height: (root.drag-y2 - root.drag-y1 > 0 ? root.drag-y2 - root.drag-y1 : root.drag-y1 - root.drag-y2) * 1px;
                background: transparent;
                border-width: 2px;
                border-color: #3b82f6;
                border-radius: 9999px;
            }

            // Arrow/Freehand preview: thin line from start to current
            if (root.drag-active && (root.active-tool == "arrow" || root.active-tool == "pen")) : Rectangle {
                x: (root.drag-x1 < root.drag-x2 ? root.drag-x1 : root.drag-x2) * 1px;
                y: (root.drag-y1 < root.drag-y2 ? root.drag-y1 : root.drag-y2) * 1px;
                width: (root.drag-x2 - root.drag-x1 > 0 ? root.drag-x2 - root.drag-x1 : root.drag-x1 - root.drag-x2) * 1px;
                height: 2px;
                background: #f59e0b60;
                border-radius: 1px;
            }

            // Step placement preview dot
            if (root.drag-active && root.active-tool == "step") : Rectangle {
                x: root.drag-x2 * 1px - 16px;
                y: root.drag-y2 * 1px - 16px;
                width: 32px; height: 32px;
                background: #22d45e;
                border-radius: 16px;
                border-width: 2px;
                border-color: #ffffff;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.current-step;
                        font-size: 12px; font-weight: 900; color: #000000;
                        vertical-alignment: center;
                    }
                }
            }

            // ── CANVAS TOUCH AREA (captures all interaction) ──────────────────
            canvas_touch := TouchArea {
                property <int> start-x;
                property <int> start-y;

                mouse-cursor: root.active-tool == "text" || root.active-tool == "step" ? MouseCursor.default : MouseCursor.crosshair;

                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            self.start-x = self.mouse-x / 1px;
                            self.start-y = self.mouse-y / 1px;
                            root.drag-active = true;
                            root.drag-x1 = self.start-x;
                            root.drag-y1 = self.start-y;
                            root.drag-x2 = self.start-x;
                            root.drag-y2 = self.start-y;
                        } else if (event.kind == PointerEventKind.up) {
                            root.drag-active = false;
                            let ex = self.mouse-x / 1px;
                            let ey = self.mouse-y / 1px;
                            root.apply-annotation(
                                root.active-tool,
                                root.active-color,
                                root.stroke-size,
                                self.start-x,
                                self.start-y,
                                ex,
                                ey
                            );
                        }
                    }
                }

                moved => {
                    root.drag-x2 = self.mouse-x / 1px;
                    root.drag-y2 = self.mouse-y / 1px;
                }
            }
        }

        // ── ANNOTATION TOOLBAR (BOTTOM — Awesome Screenshot style) ────────────
        Rectangle {
            height: 106px;
            background: #0b1120;
            border-radius: 0px;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                // ── Row 1: Tool Buttons ──────────────────────────────────────
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    // Pen / Freehand
                    pen_btn := Rectangle {
                        width: 76px; height: 38px;
                        background: root.active-tool == "pen" ? #22d45e : (pen_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.active-tool == "pen" ? #22d45e : #2a3a52;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            spacing: 5px; alignment: center;
                            Text { text: "✏"; font-size: 15px; vertical-alignment: center; }
                            Text {
                                text: "Pen";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tool == "pen" ? #000000 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        pen_t := TouchArea { clicked => { root.select-tool("pen"); root.status-text = "Drag to draw freehand strokes"; } }
                    }

                    // Arrow
                    arrow_btn := Rectangle {
                        width: 76px; height: 38px;
                        background: root.active-tool == "arrow" ? #22d45e : (arrow_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.active-tool == "arrow" ? #22d45e : #2a3a52;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            spacing: 5px; alignment: center;
                            Text { text: "→"; font-size: 16px; vertical-alignment: center; color: root.active-tool == "arrow" ? #000000 : #94a3b8; }
                            Text {
                                text: "Arrow";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tool == "arrow" ? #000000 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        arrow_t := TouchArea { clicked => { root.select-tool("arrow"); root.status-text = "Drag to draw directional arrows"; } }
                    }

                    // Rectangle
                    rect_btn := Rectangle {
                        width: 76px; height: 38px;
                        background: root.active-tool == "rect" ? #22d45e : (rect_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.active-tool == "rect" ? #22d45e : #2a3a52;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            spacing: 5px; alignment: center;
                            Text { text: "▭"; font-size: 15px; vertical-alignment: center; color: root.active-tool == "rect" ? #000000 : #94a3b8; }
                            Text {
                                text: "Rect";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tool == "rect" ? #000000 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        rect_t := TouchArea { clicked => { root.select-tool("rect"); root.status-text = "Drag to draw highlight rectangles"; } }
                    }

                    // Oval
                    oval_btn := Rectangle {
                        width: 76px; height: 38px;
                        background: root.active-tool == "oval" ? #22d45e : (oval_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.active-tool == "oval" ? #22d45e : #2a3a52;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            spacing: 5px; alignment: center;
                            Text { text: "○"; font-size: 16px; vertical-alignment: center; color: root.active-tool == "oval" ? #000000 : #94a3b8; }
                            Text {
                                text: "Oval";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tool == "oval" ? #000000 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        oval_t := TouchArea { clicked => { root.select-tool("oval"); root.status-text = "Drag to draw ellipses and circles"; } }
                    }

                    // Text Callout
                    text_btn := Rectangle {
                        width: 76px; height: 38px;
                        background: root.active-tool == "text" ? #22d45e : (text_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.active-tool == "text" ? #22d45e : #2a3a52;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            spacing: 5px; alignment: center;
                            Text { text: "T"; font-size: 16px; font-weight: 900; vertical-alignment: center; color: root.active-tool == "text" ? #000000 : #94a3b8; }
                            Text {
                                text: "Text";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tool == "text" ? #000000 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        text_t := TouchArea { clicked => { root.select-tool("text"); root.status-text = "Click to place a text callout label"; } }
                    }

                    // Step Number
                    step_btn := Rectangle {
                        width: 76px; height: 38px;
                        background: root.active-tool == "step" ? #22d45e : (step_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.active-tool == "step" ? #22d45e : #2a3a52;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            spacing: 5px; alignment: center;
                            Rectangle {
                                width: 20px; height: 20px;
                                background: root.active-tool == "step" ? #000000 : #22d45e;
                                border-radius: 10px;
                                Text {
                                    text: root.current-step;
                                    font-size: 10px; font-weight: 900;
                                    color: root.active-tool == "step" ? #22d45e : #000000;
                                    x: (parent.width - self.width)/2;
                                    y: (parent.height - self.height)/2;
                                }
                            }
                            Text {
                                text: "Step";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tool == "step" ? #000000 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        step_t := TouchArea { clicked => { root.select-tool("step"); root.status-text = "Click to place step numbers ①②③"; } }
                    }

                    // Blur / Redact
                    blur_btn := Rectangle {
                        width: 76px; height: 38px;
                        background: root.active-tool == "blur" ? #22d45e : (blur_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.active-tool == "blur" ? #22d45e : #2a3a52;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            spacing: 5px; alignment: center;
                            Text { text: "▓"; font-size: 15px; vertical-alignment: center; color: root.active-tool == "blur" ? #000000 : #94a3b8; }
                            Text {
                                text: "Blur";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tool == "blur" ? #000000 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        blur_t := TouchArea { clicked => { root.select-tool("blur"); root.status-text = "Drag to redact / pixelate private areas"; } }
                    }

                    // Spotlight
                    spot_btn := Rectangle {
                        width: 76px; height: 38px;
                        background: root.active-tool == "spotlight" ? #22d45e : (spot_t.has-hover ? #1e293b : #161e2e);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.active-tool == "spotlight" ? #22d45e : #2a3a52;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            spacing: 5px; alignment: center;
                            Text { text: "◎"; font-size: 15px; vertical-alignment: center; color: root.active-tool == "spotlight" ? #000000 : #94a3b8; }
                            Text {
                                text: "Focus";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tool == "spotlight" ? #000000 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        spot_t := TouchArea { clicked => { root.select-tool("spotlight"); root.status-text = "Drag to spotlight a region, dims everything else"; } }
                    }
                }

                // ── Row 2: Color Palette + Stroke + Action Buttons ────────────
                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    // Color Swatches (horizontal row)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text { text: "COLOR"; font-size: 8px; font-weight: 900; color: #475569; vertical-alignment: center; }

                        Rectangle { width: 24px; height: 24px; background: #ff3b30; border-radius: 12px; border-width: root.active-color == "#FF3B30" ? 2.5px : 0px; border-color: #ffffff; TouchArea { clicked => { root.select-color("#FF3B30"); } } }
                        Rectangle { width: 24px; height: 24px; background: #f59e0b; border-radius: 12px; border-width: root.active-color == "#F59E0B" ? 2.5px : 0px; border-color: #ffffff; TouchArea { clicked => { root.select-color("#F59E0B"); } } }
                        Rectangle { width: 24px; height: 24px; background: #22d45e; border-radius: 12px; border-width: root.active-color == "#22D45E" ? 2.5px : 0px; border-color: #ffffff; TouchArea { clicked => { root.select-color("#22D45E"); } } }
                        Rectangle { width: 24px; height: 24px; background: #3b82f6; border-radius: 12px; border-width: root.active-color == "#3B82F6" ? 2.5px : 0px; border-color: #ffffff; TouchArea { clicked => { root.select-color("#3B82F6"); } } }
                        Rectangle { width: 24px; height: 24px; background: #8b5cf6; border-radius: 12px; border-width: root.active-color == "#8B5CF6" ? 2.5px : 0px; border-color: #ffffff; TouchArea { clicked => { root.select-color("#8B5CF6"); } } }
                        Rectangle { width: 24px; height: 24px; background: #ffffff; border-radius: 12px; border-width: root.active-color == "#FFFFFF" ? 2.5px : 0px; border-color: #64748b; TouchArea { clicked => { root.select-color("#FFFFFF"); } } }
                        Rectangle { width: 24px; height: 24px; background: #000000; border-radius: 12px; border-width: root.active-color == "#000000" ? 2.5px : 0px; border-color: #64748b; TouchArea { clicked => { root.select-color("#000000"); } } }
                    }

                    // Separator
                    Rectangle { width: 1px; height: 28px; background: #1e293b; y: (parent.height - self.height)/2; }

                    // Stroke Width Selector
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        Text { text: "WEIGHT"; font-size: 8px; font-weight: 900; color: #475569; vertical-alignment: center; }

                        sw1 := Rectangle {
                            width: 42px; height: 28px;
                            background: root.stroke-size == 1 ? #22d45e : (sw1_t.has-hover ? #1e293b : #161e2e);
                            border-radius: 6px;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px; height: 2px;
                                    background: root.stroke-size == 1 ? #000000 : #94a3b8;
                                    y: (parent.height - self.height)/2;
                                }
                            }
                            sw1_t := TouchArea { clicked => { root.select-stroke(1); } }
                        }

                        sw2 := Rectangle {
                            width: 42px; height: 28px;
                            background: root.stroke-size == 2 ? #22d45e : (sw2_t.has-hover ? #1e293b : #161e2e);
                            border-radius: 6px;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px; height: 4px;
                                    background: root.stroke-size == 2 ? #000000 : #94a3b8;
                                    y: (parent.height - self.height)/2;
                                    border-radius: 2px;
                                }
                            }
                            sw2_t := TouchArea { clicked => { root.select-stroke(2); } }
                        }

                        sw3 := Rectangle {
                            width: 42px; height: 28px;
                            background: root.stroke-size == 3 ? #22d45e : (sw3_t.has-hover ? #1e293b : #161e2e);
                            border-radius: 6px;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px; height: 7px;
                                    background: root.stroke-size == 3 ? #000000 : #94a3b8;
                                    y: (parent.height - self.height)/2;
                                    border-radius: 3px;
                                }
                            }
                            sw3_t := TouchArea { clicked => { root.select-stroke(3); } }
                        }
                    }

                    // Separator
                    Rectangle { width: 1px; height: 28px; background: #1e293b; y: (parent.height - self.height)/2; }

                    // Action Buttons (Undo / Clear / Copy / Save)
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        undo_btn := Rectangle {
                            height: 30px;
                            background: undo_t.has-hover ? #1e293b : #161e2e;
                            border-radius: 8px;
                            border-width: 1px; border-color: #334155;
                            animate background { duration: 100ms; }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; alignment: center;
                                Text { text: "↩ UNDO"; font-size: 9px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }
                            }
                            undo_t := TouchArea { clicked => { root.undo-annotation(); } }
                        }

                        clear_btn := Rectangle {
                            height: 30px;
                            background: clear_t.has-hover ? #1e293b : #161e2e;
                            border-radius: 8px;
                            border-width: 1px; border-color: #334155;
                            animate background { duration: 100ms; }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; alignment: center;
                                Text { text: "🗑 CLEAR"; font-size: 9px; font-weight: 800; color: #ef4444; vertical-alignment: center; }
                            }
                            clear_t := TouchArea { clicked => { root.clear-annotations(); } }
                        }

                        copy_btn := Rectangle {
                            height: 30px;
                            background: copy_t.has-hover ? #1e293b : #161e2e;
                            border-radius: 8px;
                            border-width: 1px; border-color: #38bdf8;
                            animate background { duration: 100ms; }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; alignment: center;
                                Text { text: "📋 COPY"; font-size: 9px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                            }
                            copy_t := TouchArea { clicked => { root.copy-clipboard(); } }
                        }

                        save_btn := Rectangle {
                            height: 30px;
                            background: save_t.has-hover ? #16a34a : #22d45e;
                            border-radius: 8px;
                            animate background { duration: 100ms; }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; alignment: center;
                                Text { text: "💾 SAVE"; font-size: 10px; font-weight: 900; color: #000000; vertical-alignment: center; }
                            }
                            save_t := TouchArea { clicked => { root.save-editor-snapshot(); } }
                        }
                    }
                }
            }
        }
    }
}
