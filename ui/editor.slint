export component StudioEditor inherits Rectangle {
    width: 860px;
    height: 580px;
    background: #080c14;
    border-radius: 20px;
    border-width: 1.5px;
    border-color: #22d45e;
    drop-shadow-blur: 36px;
    drop-shadow-color: #22d45e35;

    in-out property <string> active-tool: "arrow";
    in-out property <string> active-color: "#00FF66";
    in-out property <image> canvas-image;
    in-out property <bool> has-canvas-image: false;
    in-out property <bool> watermark-active: true;
    in-out property <string> status-text: "Showcase Studio Ready";

    callback close-editor();
    callback select-tool(string);
    callback select-color(string);
    callback open-file-dialog();
    callback copy-clipboard();
    callback undo-annotation();
    callback clear-annotations();
    callback apply-blur-region(int, int, int, int);
    callback save-editor-snapshot();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // Top Studio Header Bar
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Text {
                    text: "🎨 SHOWCASE CREATIVE STUDIO";
                    font-size: 13px;
                    font-weight: 900;
                    color: #22d45e;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 22px;
                    background: #0f1623;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #1e293b;

                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; alignment: center;
                        Text {
                            text: "PRO CANVAS";
                            font-size: 9px;
                            font-weight: 800;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                // Watermark Toggle Pill
                wm_pill := Rectangle {
                    height: 30px;
                    background: root.watermark-active ? #3b82f6 : #0f1623;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.watermark-active ? #3b82f6 : #1e293b;
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; alignment: center;
                        Text {
                            text: root.watermark-active ? "🏷️ WATERMARK ON" : "🏷️ WATERMARK OFF";
                            font-size: 9px; font-weight: 800; color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                    wm_touch := TouchArea { clicked => { root.watermark-active = !root.watermark-active; } }
                }

                // Open File Button
                open_btn := Rectangle {
                    height: 30px;
                    background: open_touch.has-hover ? #1e293b : #0f1623;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #38bdf8;
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; alignment: center;
                        Text {
                            text: "📂 OPEN FILE";
                            font-size: 9px; font-weight: 800; color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }
                    open_touch := TouchArea { clicked => { root.open-file-dialog(); } }
                }

                // Close Studio Button
                close_btn := Rectangle {
                    width: 30px; height: 30px;
                    background: close_touch.has-hover ? #1e293b : #0f1623;
                    border-radius: 15px;
                    animate background { duration: 100ms; }

                    Text {
                        text: "✕";
                        font-size: 13px; color: #ffffff;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                    close_touch := TouchArea { clicked => { root.close-editor(); } }
                }
            }
        }

        // Main Studio Workspace Layout (Left Toolbox Sidebar + Canvas Area)
        HorizontalLayout {
            spacing: 12px;

            // Left Toolbox Sidebar Panel
            Rectangle {
                width: 72px;
                background: #0f1623;
                border-radius: 14px;
                border-width: 1px;
                border-color: #1e293b;

                VerticalLayout {
                    padding: 8px;
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "TOOLS";
                        font-size: 8px; font-weight: 900; color: #64748b;
                        horizontal-alignment: center;
                    }

                    // Tool 1: Arrow
                    t_arrow := Rectangle {
                        height: 40px;
                        background: root.active-tool == "arrow" ? #22d45e : (t_arrow_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: "🏹"; font-size: 14px; horizontal-alignment: center; }
                            Text {
                                text: "Arrow"; font-size: 8px; font-weight: 800;
                                color: root.active-tool == "arrow" ? #000000 : #94a3b8;
                                horizontal-alignment: center;
                            }
                        }
                        t_arrow_t := TouchArea { clicked => { root.select-tool("arrow"); } }
                    }

                    // Tool 2: Text Callout
                    t_text := Rectangle {
                        height: 40px;
                        background: root.active-tool == "text" ? #22d45e : (t_text_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: "🔤"; font-size: 14px; horizontal-alignment: center; }
                            Text {
                                text: "Text"; font-size: 8px; font-weight: 800;
                                color: root.active-tool == "text" ? #000000 : #94a3b8;
                                horizontal-alignment: center;
                            }
                        }
                        t_text_t := TouchArea { clicked => { root.select-tool("text"); } }
                    }

                    // Tool 3: Blur / Redact
                    t_blur := Rectangle {
                        height: 40px;
                        background: root.active-tool == "blur" ? #22d45e : (t_blur_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: "💧"; font-size: 14px; horizontal-alignment: center; }
                            Text {
                                text: "Redact"; font-size: 8px; font-weight: 800;
                                color: root.active-tool == "blur" ? #000000 : #94a3b8;
                                horizontal-alignment: center;
                            }
                        }
                        t_blur_t := TouchArea { clicked => { root.select-tool("blur"); } }
                    }

                    // Tool 4: Box Highlight
                    t_box := Rectangle {
                        height: 40px;
                        background: root.active-tool == "box" ? #22d45e : (t_box_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: "📐"; font-size: 14px; horizontal-alignment: center; }
                            Text {
                                text: "Box"; font-size: 8px; font-weight: 800;
                                color: root.active-tool == "box" ? #000000 : #94a3b8;
                                horizontal-alignment: center;
                            }
                        }
                        t_box_t := TouchArea { clicked => { root.select-tool("box"); } }
                    }

                    Rectangle { height: 1px; background: #1e293b; }

                    Text {
                        text: "PALETTE";
                        font-size: 8px; font-weight: 900; color: #64748b;
                        horizontal-alignment: center;
                    }

                    // Color Palette Swatches
                    VerticalLayout {
                        spacing: 6px; alignment: center;

                        Rectangle {
                            width: 26px; height: 26px; background: #00ff66; border-radius: 13px;
                            border-width: root.active-color == "#00FF66" ? 2.5px : 0px; border-color: #ffffff;
                            TouchArea { clicked => { root.select-color("#00FF66"); } }
                        }
                        Rectangle {
                            width: 26px; height: 26px; background: #3b82f6; border-radius: 13px;
                            border-width: root.active-color == "#3B82F6" ? 2.5px : 0px; border-color: #ffffff;
                            TouchArea { clicked => { root.select-color("#3B82F6"); } }
                        }
                        Rectangle {
                            width: 26px; height: 26px; background: #ff3b30; border-radius: 13px;
                            border-width: root.active-color == "#FF3B30" ? 2.5px : 0px; border-color: #ffffff;
                            TouchArea { clicked => { root.select-color("#FF3B30"); } }
                        }
                        Rectangle {
                            width: 26px; height: 26px; background: #f59e0b; border-radius: 13px;
                            border-width: root.active-color == "#F59E0B" ? 2.5px : 0px; border-color: #ffffff;
                            TouchArea { clicked => { root.select-color("#F59E0B"); } }
                        }
                        Rectangle {
                            width: 26px; height: 26px; background: #ffffff; border-radius: 13px;
                            border-width: root.active-color == "#FFFFFF" ? 2.5px : 0px; border-color: #000000;
                            TouchArea { clicked => { root.select-color("#FFFFFF"); } }
                        }
                    }

                    Rectangle { height: 1px; background: #1e293b; }

                    // Undo & Clear Stack Buttons
                    undo_b := Rectangle {
                        height: 28px;
                        background: undo_t.has-hover ? #1e293b : #161e2e;
                        border-radius: 6px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 4px; padding-right: 4px; alignment: center;
                            Text { text: "↩ Undo"; font-size: 8px; font-weight: 800; color: #cbd5e1; vertical-alignment: center; }
                        }
                        undo_t := TouchArea { clicked => { root.undo-annotation(); } }
                    }

                    clear_b := Rectangle {
                        height: 28px;
                        background: clear_t.has-hover ? #1e293b : #161e2e;
                        border-radius: 6px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 4px; padding-right: 4px; alignment: center;
                            Text { text: "🗑 Clear"; font-size: 8px; font-weight: 800; color: #ef4444; vertical-alignment: center; }
                        }
                        clear_t := TouchArea { clicked => { root.clear-annotations(); } }
                    }
                }
            }

            // Main Interactive Canvas Surface
            canvas_box := Rectangle {
                background: #0f1623;
                border-radius: 14px;
                border-width: 1px;
                border-color: #1e293b;

                if (root.has-canvas-image) : Image {
                    source: root.canvas-image;
                    width: 100%;
                    height: 100%;
                }

                if (!root.has-canvas-image) : Text {
                    text: "✨ Click '📂 OPEN FILE' or capture a snapshot to preview & annotate";
                    font-size: 13px; color: #64748b; font-weight: 700;
                    x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                }

                // Dragging Interaction Handler
                TouchArea {
                    property <int> drag-start-x;
                    property <int> drag-start-y;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left) {
                            if (event.kind == PointerEventKind.down) {
                                self.drag-start-x = self.mouse-x / 1px;
                                self.drag-start-y = self.mouse-y / 1px;
                            } else if (event.kind == PointerEventKind.up) {
                                let end-x = self.mouse-x / 1px;
                                let end-y = self.mouse-y / 1px;
                                let w = end-x - self.drag-start-x;
                                let h = end-y - self.drag-start-y;
                                root.apply-blur-region(self.drag-start-x, self.drag-start-y, w, h);
                            }
                        }
                    }
                }
            }
        }

        // Bottom Footer Bar
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: root.status-text;
                font-size: 10px; color: #94a3b8; vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;

                copy_b := Rectangle {
                    height: 36px;
                    background: copy_t.has-hover ? #1e293b : #0f1623;
                    border-radius: 10px; border-width: 1px; border-color: #38bdf8;
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; alignment: center;
                        Text { text: "📋 COPY"; font-size: 10px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                    }
                    copy_t := TouchArea { clicked => { root.copy-clipboard(); } }
                }

                cancel_b := Rectangle {
                    height: 36px;
                    background: cancel_t.has-hover ? #1e293b : #0f1623;
                    border-radius: 10px; border-width: 1px; border-color: #1e293b;
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; alignment: center;
                        Text { text: "CANCEL"; font-size: 10px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }
                    }
                    cancel_t := TouchArea { clicked => { root.close-editor(); } }
                }

                export_b := Rectangle {
                    height: 36px;
                    background: export_t.has-hover ? #16a34a : #22d45e;
                    border-radius: 10px;
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; alignment: center;
                        Text { text: "💾 SAVE & EXPORT"; font-size: 11px; font-weight: 900; color: #000000; vertical-alignment: center; }
                    }
                    export_t := TouchArea { clicked => { root.save-editor-snapshot(); } }
                }
            }
        }
    }
}
