import { SettingsModal } from "settings.slint";
import { StudioEditor } from "editor.slint";
import { WindowPickerModal, WindowItem } from "window_picker.slint";
export { RegionSelectorWindow } from "region_selector.slint";
export { WebcamPipWindow } from "webcam_pip.slint";

export component AppWindow inherits Window {
    width: root.show-settings-modal ? 700px : (root.show-editor-modal ? 920px : (root.show-window-picker ? 640px : 820px));
    height: root.show-settings-modal ? 440px : (root.show-editor-modal ? 620px : (root.show-window-picker ? 420px : 60px));
    no-frame: true;
    background: transparent;
    always-on-top: true;

    // Core Properties
    in-out property <string> primary-mode: "image";
    in-out property <bool> is-recording: false;
    in-out property <string> selected-mode: "desktop";
    in-out property <string> resolution: "1080p";
    in-out property <bool> audio-enabled: false;
    in-out property <bool> webcam-enabled: false;

    // State
    in-out property <string> lang: "en";
    in-out property <string> hw-encoder-tag: "[SW x264]";
    in-out property <string> status-message: "Ready";

    // Canvas
    in-out property <image> canvas-image;
    in-out property <bool> has-canvas-image: false;

    // Modal Controls
    in-out property <bool> show-settings-modal: false;
    in-out property <bool> show-editor-modal: false;
    in-out property <bool> show-support-modal: false;
    in-out property <bool> show-window-picker: false;
    in-out property <[WindowItem]> window-list;

    // Config
    in-out property <string> active-encoder: "Auto";
    in-out property <string> save-path: "/home/user/Videos";
    in-out property <string> watermark-text: "WOLFITWAY";
    in-out property <bool> watermark-enabled: true;
    in-out property <bool> cinematic-zoom-enabled: true;

    // Customizable Hotkey Properties
    in-out property <string> hotkey-record: "Super+Shift+R";
    in-out property <string> hotkey-snapshot: "Super+Shift+S";
    in-out property <string> hotkey-region: "Super+Shift+X";
    in-out property <string> hotkey-cancel: "Escape";

    // Callbacks
    callback select-primary-mode(string);
    callback toggle-recording();
    callback take-snapshot();
    callback open-studio-editor();
    callback select-mode(string);
    callback select-resolution(string);
    callback toggle-audio();
    callback toggle-webcam();
    callback open-region-selector();
    callback open-window-picker();
    callback select-target-window(int, int, int, int, string);
    callback toggle-language();
    callback select-language(string);
    callback select-encoder(string);
    callback save-config();
    callback open-file-dialog();
    callback upload-logo-dialog();
    callback copy-clipboard();
    callback undo-annotation();
    callback clear-annotations();
    callback apply-annotation(string, string, int, int, int, int, int, string);
    callback save-editor-export();
    callback open-paddle-checkout();
    callback move-window(length, length);

    // ── ROOT CARD ─────────────────────────────────────────────────────────────
    Rectangle {
        width: 100%;
        height: 100%;
        background: #080c14;
        border-radius: root.show-settings-modal || root.show-editor-modal || root.show-window-picker ? 20px : 16px;
        border-width: 1.5px;
        border-color: root.is-recording ? #ef444470 : #22d45e30;
        drop-shadow-blur: 28px;
        drop-shadow-color: root.is-recording ? #ef444440 : #22d45e18;
        animate border-color { duration: 200ms; }
        animate drop-shadow-color { duration: 200ms; }

        // Drag handle
        TouchArea {
            property <length> start-x;
            property <length> start-y;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left) {
                    if (event.kind == PointerEventKind.down) {
                        self.start-x = self.mouse-x;
                        self.start-y = self.mouse-y;
                    }
                }
            }
            moved => { root.move-window(self.mouse-x - self.start-x, self.mouse-y - self.start-y); }
        }

        // ── VIEW 1: MINIMAL SINGLE-ROW TOOLBAR ────────────────────────────────
        if (!root.show-settings-modal && !root.show-editor-modal && !root.show-window-picker) : HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            alignment: space-between;

            // ── LEFT: Brand Icon + Mode Toggle Pill ─────────────────────────
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                // Wolf brand mark
                Rectangle {
                    width: 36px; height: 36px;
                    background: #0f1623;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #22d45e40;

                    Text {
                        text: "🐺";
                        font-size: 18px;
                        x: (parent.width - self.width)/2;
                        y: (parent.height - self.height)/2;
                    }
                }

                // Mode Segmented Toggle (📷 / 🎬)
                Rectangle {
                    height: 36px;
                    background: #0f1623;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #1e293b;

                    HorizontalLayout {
                        padding: 3px; spacing: 2px;

                        img_mode := Rectangle {
                            width: 34px; height: 30px;
                            background: root.primary-mode == "image" ? #22d45e : (img_mt.has-hover ? #161e2e : transparent);
                            border-radius: 8px;
                            animate background { duration: 100ms; }
                            Text {
                                text: "📷";
                                font-size: 14px;
                                x: (parent.width - self.width)/2;
                                y: (parent.height - self.height)/2;
                            }
                            img_mt := TouchArea { clicked => { root.select-primary-mode("image"); } }
                        }

                        vid_mode := Rectangle {
                            width: 34px; height: 30px;
                            background: root.primary-mode == "video" ? #22d45e : (vid_mt.has-hover ? #161e2e : transparent);
                            border-radius: 8px;
                            animate background { duration: 100ms; }
                            Text {
                                text: "🎬";
                                font-size: 14px;
                                x: (parent.width - self.width)/2;
                                y: (parent.height - self.height)/2;
                            }
                            vid_mt := TouchArea { clicked => { root.select-primary-mode("video"); } }
                        }
                    }
                }
            }

            // ── CENTER: Capture Target Selector ─────────────────────────────
            Rectangle {
                height: 36px;
                background: #0f1623;
                border-radius: 10px;
                border-width: 1px;
                border-color: #1e293b;

                HorizontalLayout {
                    padding: 3px; spacing: 2px;

                    tgt_desk := Rectangle {
                        height: 30px;
                        background: root.selected-mode == "desktop" ? #22d45e : (td_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: center;
                            Text {
                                text: "⊡ Desktop";
                                font-size: 10px; font-weight: 800;
                                color: root.selected-mode == "desktop" ? #000000 : #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                        td_t := TouchArea { clicked => { root.select-mode("desktop"); } }
                    }

                    Rectangle { width: 1px; height: 20px; background: #1e293b; y: (parent.height - self.height)/2; }

                    tgt_win := Rectangle {
                        height: 30px;
                        background: root.selected-mode == "window" ? #22d45e : (tw_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: center;
                            Text {
                                text: "⊞ Window";
                                font-size: 10px; font-weight: 800;
                                color: root.selected-mode == "window" ? #000000 : #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                        tw_t := TouchArea {
                            clicked => {
                                root.select-mode("window");
                                root.open-window-picker();
                            }
                        }
                    }

                    Rectangle { width: 1px; height: 20px; background: #1e293b; y: (parent.height - self.height)/2; }

                    tgt_reg := Rectangle {
                        height: 30px;
                        background: root.selected-mode == "region" ? #22d45e : (tr_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: center;
                            Text {
                                text: "✂️ Region";
                                font-size: 10px; font-weight: 800;
                                color: root.selected-mode == "region" ? #000000 : #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                        tr_t := TouchArea {
                            clicked => {
                                root.select-mode("region");
                                root.open-region-selector();
                            }
                        }
                    }
                }
            }

            // ── RIGHT: Secondary Icons + Primary CTA ────────────────────────
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                // Image mode: Open file + Studio buttons
                if (root.primary-mode == "image") : HorizontalLayout {
                    spacing: 6px;

                    open_icon := Rectangle {
                        width: 36px; height: 36px;
                        background: open_i_t.has-hover ? #1e293b : #0f1623;
                        border-radius: 10px;
                        border-width: 1px; border-color: #38bdf8;
                        animate background { duration: 100ms; }
                        Text { text: "📂"; font-size: 16px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                        open_i_t := TouchArea { clicked => { root.open-file-dialog(); } }
                    }

                    studio_icon := Rectangle {
                        width: 36px; height: 36px;
                        background: studio_i_t.has-hover ? #1e293b : #0f1623;
                        border-radius: 10px;
                        border-width: 1px; border-color: #22d45e;
                        animate background { duration: 100ms; }
                        Text { text: "✏️"; font-size: 16px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                        studio_i_t := TouchArea { clicked => { root.open-studio-editor(); } }
                    }
                }

                // Video mode: Mic + Cam icon toggles
                if (root.primary-mode == "video") : HorizontalLayout {
                    spacing: 6px;

                    mic_icon := Rectangle {
                        width: 36px; height: 36px;
                        background: root.audio-enabled ? #161e2e : (mic_i_t.has-hover ? #1e293b : #0f1623);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.audio-enabled ? #22d45e : #1e293b;
                        animate background { duration: 100ms; }
                        Text {
                            text: root.audio-enabled ? "🎤" : "🔇";
                            font-size: 16px;
                            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        }
                        mic_i_t := TouchArea { clicked => { root.toggle-audio(); } }
                    }

                    cam_icon := Rectangle {
                        width: 36px; height: 36px;
                        background: root.webcam-enabled ? #161e2e : (cam_i_t.has-hover ? #1e293b : #0f1623);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.webcam-enabled ? #22d45e : #1e293b;
                        animate background { duration: 100ms; }
                        Text {
                            text: root.webcam-enabled ? "📸" : "📷";
                            font-size: 16px;
                            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        }
                        cam_i_t := TouchArea { clicked => { root.toggle-webcam(); } }
                    }
                }

                // Thin divider
                Rectangle { width: 1px; height: 24px; background: #1e293b; y: (parent.height - self.height)/2; }

                // Lang toggle icon
                lang_icon := Rectangle {
                    width: 40px; height: 36px;
                    background: lang_i_t.has-hover ? #1e293b : #0f1623;
                    border-radius: 10px;
                    border-width: 1px; border-color: #334155;
                    animate background { duration: 100ms; }
                    Text {
                        text: root.lang == "ro" ? "🇷🇴" : (root.lang == "es" ? "🇪🇸" : (root.lang == "de" ? "🇩🇪" : (root.lang == "fr" ? "🇫🇷" : (root.lang == "ja" ? "🇯🇵" : "🇬🇧"))));
                        font-size: 16px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                    lang_i_t := TouchArea { clicked => { root.toggle-language(); } }
                }

                // Settings gear icon
                settings_icon := Rectangle {
                    width: 36px; height: 36px;
                    background: settings_i_t.has-hover ? #1e293b : #0f1623;
                    border-radius: 10px;
                    border-width: 1px; border-color: #334155;
                    animate background { duration: 100ms; }
                    Text { text: "⚙"; font-size: 16px; color: #cbd5e1; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                    settings_i_t := TouchArea { clicked => { root.show-settings-modal = true; } }
                }

                // ── PRIMARY HERO CTA ──────────────────────────────────────
                if (root.primary-mode == "image") : snap_cta := Rectangle {
                    height: 36px;
                    background: snap_cta_t.has-hover ? #16a34a : #22d45e;
                    border-radius: 10px;
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        spacing: 6px; alignment: center;
                        Text { text: "📸"; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Snapshot"; font-size: 11px; font-weight: 900; color: #000000; vertical-alignment: center; }
                    }
                    snap_cta_t := TouchArea { clicked => { root.take-snapshot(); } }
                }

                if (root.primary-mode == "video") : rec_cta := Rectangle {
                    height: 36px;
                    background: root.is-recording
                        ? (rec_cta_t.has-hover ? #dc2626 : #ef4444)
                        : (rec_cta_t.has-hover ? #16a34a : #22d45e);
                    border-radius: 10px;
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        spacing: 6px; alignment: center;
                        Rectangle {
                            width: 8px; height: 8px;
                            background: root.is-recording ? #ffffff : #000000;
                            border-radius: 4px;
                            y: (parent.height - self.height)/2;
                        }
                        Text {
                            text: root.is-recording ? "Stop" : "Record";
                            font-size: 11px; font-weight: 900;
                            color: root.is-recording ? #ffffff : #000000;
                            vertical-alignment: center;
                        }
                    }
                    rec_cta_t := TouchArea { clicked => { root.toggle-recording(); } }
                }
            }
        }

        // ── VIEW 2: SETTINGS PANEL ────────────────────────────────────────────
        if (root.show-settings-modal) : SettingsModal {
            width: 100%; height: 100%;
            active-lang: root.lang;
            active-encoder: root.active-encoder;
            save-path: root.save-path;
            watermark-text: root.watermark-text;
            auto-watermark: root.watermark-enabled;
            cinematic-zoom: root.cinematic-zoom-enabled;
            hotkey-record: root.hotkey-record;
            hotkey-snapshot: root.hotkey-snapshot;
            hotkey-region: root.hotkey-region;
            hotkey-cancel: root.hotkey-cancel;
            close-settings => { root.show-settings-modal = false; }
            select-language(l) => { root.select-language(l); }
            select-encoder(e) => { root.select-encoder(e); }
            save-settings => { root.save-config(); }
        }

        // ── VIEW 3: STUDIO EDITOR ─────────────────────────────────────────────
        if (root.show-editor-modal) : StudioEditor {
            width: 100%; height: 100%;
            canvas-image: root.canvas-image;
            has-canvas-image: root.has-canvas-image;
            watermark-active: root.watermark-enabled;
            close-editor => { root.show-editor-modal = false; }
            open-file-dialog => { root.open-file-dialog(); }
            copy-clipboard => { root.copy-clipboard(); }
            undo-annotation => { root.undo-annotation(); }
            clear-annotations => { root.clear-annotations(); }
            apply-annotation(tool, color, stroke, x1, y1, x2, y2, custom_text) => {
                root.apply-annotation(tool, color, stroke, x1, y1, x2, y2, custom_text);
            }
            save-editor-snapshot => { root.save-editor-export(); }
        }

        // ── VIEW 4: WINDOW SELECTION PICKER ───────────────────────────────────
        if (root.show-window-picker) : WindowPickerModal {
            width: 100%; height: 100%;
            window-list: root.window-list;
            close-window-picker => { root.show-window-picker = false; }
            select-target-window(x, y, w, h, title) => {
                root.select-target-window(x, y, w, h, title);
            }
        }
    }
}