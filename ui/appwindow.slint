import { SettingsModal } from "settings.slint";
import { StudioEditor } from "editor.slint";

export component AppWindow inherits Window {
    width: root.show-settings-modal ? 660px : (root.show-editor-modal ? 800px : 740px);
    height: root.show-settings-modal ? 420px : (root.show-editor-modal ? 540px : 86px);
    no-frame: true;
    background: transparent;
    always-on-top: true;

    // Core Properties
    in-out property <bool> is-recording: false;
    in-out property <string> selected-mode: "desktop";
    in-out property <string> resolution: "1080p";
    in-out property <bool> audio-enabled: false;
    in-out property <bool> webcam-enabled: false;
    
    // Hardware & Bilingual Localization State
    in-out property <string> lang: "en";
    in-out property <string> hw-encoder-tag: "[HW-AUTO]";
    in-out property <string> status-message: "Ready";

    // Canvas Image Properties
    in-out property <image> canvas-image;
    in-out property <bool> has-canvas-image: false;

    // Modal Display Controls
    in-out property <bool> show-settings-modal: false;
    in-out property <bool> show-editor-modal: false;
    in-out property <bool> show-support-modal: false;
    
    // Config Properties
    in-out property <string> active-encoder: "Auto";
    in-out property <string> save-path: "/home/user/Videos";
    in-out property <string> watermark-text: "WOLFITWAY";
    in-out property <bool> watermark-enabled: true;
    in-out property <bool> cinematic-zoom-enabled: true;

    // Callbacks
    callback toggle-recording();
    callback take-snapshot();
    callback open-studio-editor();
    callback select-mode(string);
    callback select-resolution(string);
    callback toggle-audio();
    callback toggle-webcam();
    callback toggle-language();
    callback select-language(string);
    callback select-encoder(string);
    callback save-config();
    callback open-file-dialog();
    callback copy-clipboard();
    callback apply-blur-region(int, int, int, int);
    callback save-editor-export();
    callback open-paddle-checkout();
    callback move-window(length, length);

    // Main Floating Card View
    Rectangle {
        width: 100%;
        height: 100%;
        background: #0b0f19;
        border-radius: 18px;
        border-width: 1.5px;
        border-color: root.is-recording ? #ff3b30 : #00ff66;
        drop-shadow-blur: 24px;
        drop-shadow-color: root.is-recording ? #ff3b3050 : #00ff6635;

        // Window Dragging Target
        TouchArea {
            property <length> start-x;
            property <length> start-y;
            
            pointer-event(event) => {
                if (event.button == PointerEventButton.left) {
                    if (event.kind == PointerEventKind.down) {
                        self.start-x = self.mouse-x;
                        self.start-y = self.mouse-y;
                    }
                }
            }
            moved => {
                root.move-window(self.mouse-x - self.start-x, self.mouse-y - self.start-y);
            }
        }

        // View 1: Main Floating Recorder Toolbar
        if (!root.show-settings-modal && !root.show-editor-modal) : VerticalLayout {
            padding: 10px;
            spacing: 8px;

            // Row 1: Brand & Control Toolbar
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                // Logo Badge
                Rectangle {
                    height: 36px;
                    background: #141c2e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #23314d;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: "🐺 WOLFCAP";
                            font-size: 11px;
                            font-weight: 900;
                            color: #00ff66;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            height: 18px;
                            background: #1e293b;
                            border-radius: 5px;

                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                alignment: center;

                                Text {
                                    text: root.hw-encoder-tag;
                                    font-size: 9px;
                                    font-weight: 800;
                                    color: #38bdf8;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Mode Selector Pills (FULL / WIN / CROP)
                Rectangle {
                    height: 36px;
                    background: #141c2e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #23314d;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 3px;

                        Rectangle {
                            width: 48px; height: 30px;
                            background: root.selected-mode == "desktop" ? #00ff66 : transparent;
                            border-radius: 7px;
                            Text {
                                text: "FULL";
                                font-size: 10px; font-weight: 800;
                                color: root.selected-mode == "desktop" ? #000000 : #94a3b8;
                                x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                            }
                            TouchArea { clicked => { root.select-mode("desktop"); } }
                        }

                        Rectangle {
                            width: 48px; height: 30px;
                            background: root.selected-mode == "window" ? #00ff66 : transparent;
                            border-radius: 7px;
                            Text {
                                text: "WIN";
                                font-size: 10px; font-weight: 800;
                                color: root.selected-mode == "window" ? #000000 : #94a3b8;
                                x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                            }
                            TouchArea { clicked => { root.select-mode("window"); } }
                        }

                        Rectangle {
                            width: 48px; height: 30px;
                            background: root.selected-mode == "region" ? #00ff66 : transparent;
                            border-radius: 7px;
                            Text {
                                text: "CROP";
                                font-size: 10px; font-weight: 800;
                                color: root.selected-mode == "region" ? #000000 : #94a3b8;
                                x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                            }
                            TouchArea { clicked => { root.select-mode("region"); } }
                        }
                    }
                }

                // Audio & Cam Toggles
                HorizontalLayout {
                    spacing: 5px;

                    Rectangle {
                        width: 54px; height: 36px;
                        background: root.audio-enabled ? #1e293b : #141c2e;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.audio-enabled ? #00ff66 : #23314d;

                        Text {
                            text: root.audio-enabled ? "MIC ON" : "MIC OFF";
                            font-size: 9px; font-weight: 800;
                            color: root.audio-enabled ? #00ff66 : #64748b;
                            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        }
                        TouchArea { clicked => { root.toggle-audio(); } }
                    }

                    Rectangle {
                        width: 54px; height: 36px;
                        background: root.webcam-enabled ? #1e293b : #141c2e;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.webcam-enabled ? #00ff66 : #23314d;

                        Text {
                            text: root.webcam-enabled ? "CAM ON" : "CAM OFF";
                            font-size: 9px; font-weight: 800;
                            color: root.webcam-enabled ? #00ff66 : #64748b;
                            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        }
                        TouchArea { clicked => { root.toggle-webcam(); } }
                    }
                }

                // Language Switcher Toggle
                Rectangle {
                    width: 46px; height: 36px;
                    background: #141c2e;
                    border-radius: 10px;
                    border-width: 1.2px;
                    border-color: #3b82f6;

                    Text {
                        text: root.lang == "ro" ? "RO" : (root.lang == "es" ? "ES" : (root.lang == "de" ? "DE" : (root.lang == "fr" ? "FR" : (root.lang == "ja" ? "JA" : "EN"))));
                        font-size: 11px; font-weight: 900;
                        color: #3b82f6;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                    TouchArea { clicked => { root.toggle-language(); } }
                }

                // Studio Canvas Editor Button
                Rectangle {
                    width: 44px; height: 36px;
                    background: root.show-editor-modal ? #00ff66 : #141c2e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #23314d;

                    Text {
                        text: "EDIT";
                        font-size: 9px; font-weight: 900;
                        color: root.show-editor-modal ? #000000 : #00ff66;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                    TouchArea { clicked => { root.open-studio-editor(); } }
                }

                // Settings Button (Opens Full Preferences Modal)
                Rectangle {
                    width: 36px; height: 36px;
                    background: root.show-settings-modal ? #3b82f6 : #141c2e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #23314d;

                    Text {
                        text: "SET";
                        font-size: 9px; font-weight: 800;
                        color: root.show-settings-modal ? #ffffff : #cbd5e1;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                    TouchArea { clicked => { root.show-settings-modal = !root.show-settings-modal; } }
                }

                // Snapshot Button
                Rectangle {
                    width: 36px; height: 36px;
                    background: #141c2e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #23314d;

                    Text {
                        text: "SNAP";
                        font-size: 9px; font-weight: 800;
                        color: #f59e0b;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                    TouchArea { clicked => { root.take-snapshot(); } }
                }

                // REC Button
                rec_btn := Rectangle {
                    width: 110px; height: 36px;
                    background: root.is-recording ? #ff3b30 : (rec_touch.has-hover ? #00e65c : #00ff66);
                    border-radius: 10px;

                    animate background { duration: 120ms; }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        Rectangle {
                            width: 8px; height: 8px;
                            background: root.is-recording ? #ffffff : #000000;
                            border-radius: 4px;
                            y: (parent.height - self.height)/2;
                        }

                        Text {
                            text: root.is-recording ? "STOP" : "REC";
                            font-size: 12px; font-weight: 900;
                            color: root.is-recording ? #ffffff : #000000;
                            vertical-alignment: center;
                        }
                    }

                    rec_touch := TouchArea { clicked => { root.toggle-recording(); } }
                }
            }

            // Row 2: Status & Support Strip
            HorizontalLayout {
                padding-left: 4px; padding-right: 4px;
                alignment: space-between;

                // Status text
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 6px; height: 6px;
                        background: root.is-recording ? #ff3b30 : #00ff66;
                        border-radius: 3px;
                        y: (parent.height - self.height)/2;
                    }

                    Text {
                        text: "STATUS: " + root.status-message;
                        font-size: 10px;
                        font-weight: 700;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }
                }

                // Support button
                Rectangle {
                    height: 22px;
                    background: #6366f1;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        alignment: center;

                        Text {
                            text: "💖 SUPPORT THE DEV";
                            font-size: 9px; font-weight: 800; color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.show-support-modal = true; } }
                }
            }
        }

        // View 2: Dedicated Full Settings Modal View
        if (root.show-settings-modal) : SettingsModal {
            width: 100%;
            height: 100%;
            active-lang: root.lang;
            active-encoder: root.active-encoder;
            save-path: root.save-path;
            watermark-text: root.watermark-text;
            auto-watermark: root.watermark-enabled;
            cinematic-zoom: root.cinematic-zoom-enabled;

            close-settings => { root.show-settings-modal = false; }
            select-language(l) => { root.select-language(l); }
            select-encoder(e) => { root.select-encoder(e); }
            save-settings => { root.save-config(); }
        }

        // View 3: Dedicated Full Studio Editor Canvas View
        if (root.show-editor-modal) : StudioEditor {
            width: 100%;
            height: 100%;
            canvas-image: root.canvas-image;
            has-canvas-image: root.has-canvas-image;
            watermark-active: root.watermark-enabled;

            close-editor => { root.show-editor-modal = false; }
            open-file-dialog => { root.open-file-dialog(); }
            copy-clipboard => { root.copy-clipboard(); }
            apply-blur-region(x, y, w, h) => { root.apply-blur-region(x, y, w, h); }
            save-editor-snapshot => { root.save-editor-export(); }
        }
    }
}