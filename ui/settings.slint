export component SettingsModal inherits Rectangle {
    width: 640px;
    height: 380px;
    background: #0f172a;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: #3b82f6;
    drop-shadow-blur: 24px;
    drop-shadow-color: #3b82f640;

    in-out property <string> active-tab: "general";
    in-out property <string> active-lang: "en";
    in-out property <string> active-encoder: "Auto";
    in-out property <string> save-path: "/home/user/Videos";
    in-out property <string> watermark-text: "WOLFITWAY";
    in-out property <bool> auto-watermark: true;
    in-out property <bool> cinematic-zoom: true;
    in-out property <bool> show-lang-dropdown: false;

    callback close-settings();
    callback select-language(string);
    callback select-encoder(string);
    callback save-settings();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header Title
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "⚙️ PREFERENCES & HARDWARE SETTINGS";
                font-size: 13px; font-weight: 900; color: #38bdf8;
                vertical-alignment: center;
            }

            Rectangle {
                width: 28px; height: 28px;
                background: #1e293b; border-radius: 14px;
                Text { text: "✕"; font-size: 12px; color: #94a3b8; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                TouchArea { clicked => { root.close-settings(); } }
            }
        }

        Rectangle { height: 1px; background: #334155; }

        // Navigation Tabs Bar
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                height: 30px;
                background: root.active-tab == "general" ? #3b82f6 : #1e293b;
                border-radius: 8px;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; alignment: center;
                    Text { text: "🌐 General & Lang"; font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.active-tab = "general"; } }
            }

            Rectangle {
                height: 30px;
                background: root.active-tab == "hardware" ? #3b82f6 : #1e293b;
                border-radius: 8px;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; alignment: center;
                    Text { text: "⚡ GPU & Encoding"; font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.active-tab = "hardware"; } }
            }

            Rectangle {
                height: 30px;
                background: root.active-tab == "storage" ? #3b82f6 : #1e293b;
                border-radius: 8px;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; alignment: center;
                    Text { text: "📁 Storage Paths"; font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.active-tab = "storage"; } }
            }
        }

        // Tab Content Area
        Rectangle {
            background: #1e293b;
            border-radius: 12px;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // General Tab
                if (root.active-tab == "general") : VerticalLayout {
                    spacing: 10px;

                    Text { text: "Interface Language:"; font-size: 11px; font-weight: 700; color: #94a3b8; }

                    // Custom Flag Language Select Dropdown
                    Rectangle {
                        height: 36px;
                        background: #0f172a;
                        border-radius: 8px;
                        border-width: 1.2px;
                        border-color: #3b82f6;

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: root.active-lang == "ro" ? "🇷🇴 Română" :
                                      (root.active-lang == "es" ? "🇪🇸 Español" :
                                      (root.active-lang == "de" ? "🇩🇪 Deutsch" :
                                      (root.active-lang == "fr" ? "🇫🇷 Français" :
                                      (root.active-lang == "ja" ? "🇯🇵 日本語" : "🇬🇧 English"))));
                                font-size: 11px; font-weight: 800; color: #ffffff;
                                vertical-alignment: center;
                            }

                            Text { text: "▼"; font-size: 10px; color: #3b82f6; vertical-alignment: center; }
                        }

                        TouchArea { clicked => { root.show-lang-dropdown = !root.show-lang-dropdown; } }
                    }

                    // Dropdown Menu Popover
                    if (root.show-lang-dropdown) : Rectangle {
                        background: #0f172a;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #3b82f6;

                        VerticalLayout {
                            padding: 6px; spacing: 4px;

                            Rectangle {
                                height: 28px; background: root.active-lang == "en" ? #3b82f6 : transparent; border-radius: 5px;
                                HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇬🇧 English (EN)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                TouchArea { clicked => { root.select-language("en"); root.show-lang-dropdown = false; } }
                            }
                            Rectangle {
                                height: 28px; background: root.active-lang == "ro" ? #3b82f6 : transparent; border-radius: 5px;
                                HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇷🇴 Română (RO)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                TouchArea { clicked => { root.select-language("ro"); root.show-lang-dropdown = false; } }
                            }
                            Rectangle {
                                height: 28px; background: root.active-lang == "es" ? #3b82f6 : transparent; border-radius: 5px;
                                HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇪🇸 Español (ES)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                TouchArea { clicked => { root.select-language("es"); root.show-lang-dropdown = false; } }
                            }
                            Rectangle {
                                height: 28px; background: root.active-lang == "de" ? #3b82f6 : transparent; border-radius: 5px;
                                HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇩🇪 Deutsch (DE)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                TouchArea { clicked => { root.select-language("de"); root.show-lang-dropdown = false; } }
                            }
                            Rectangle {
                                height: 28px; background: root.active-lang == "fr" ? #3b82f6 : transparent; border-radius: 5px;
                                HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇫🇷 Français (FR)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                TouchArea { clicked => { root.select-language("fr"); root.show-lang-dropdown = false; } }
                            }
                            Rectangle {
                                height: 28px; background: root.active-lang == "ja" ? #3b82f6 : transparent; border-radius: 5px;
                                HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇯🇵 日本語 (JA)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                TouchArea { clicked => { root.select-language("ja"); root.show-lang-dropdown = false; } }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #334155; }

                    HorizontalLayout {
                        alignment: space-between;

                        Text { text: "Default Brand Watermark:"; font-size: 11px; font-weight: 700; color: #94a3b8; vertical-alignment: center; }

                        Rectangle {
                            width: 52px; height: 26px;
                            background: root.auto-watermark ? #00ff66 : #334155; border-radius: 13px;
                            Text { text: root.auto-watermark ? "ON" : "OFF"; font-size: 9px; font-weight: 900; color: #000; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                            TouchArea { clicked => { root.auto-watermark = !root.auto-watermark; } }
                        }
                    }
                }

                // Hardware Tab
                if (root.active-tab == "hardware") : VerticalLayout {
                    spacing: 10px;

                    Text { text: "Hardware Video Encoder Override:"; font-size: 11px; font-weight: 700; color: #94a3b8; }

                    HorizontalLayout {
                        spacing: 6px;

                        Rectangle {
                            width: 70px; height: 32px;
                            background: root.active-encoder == "Auto" ? #00ff66 : #0f172a; border-radius: 6px;
                            Text { text: "⚡ AUTO"; font-size: 9px; font-weight: 800; color: root.active-encoder == "Auto" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                            TouchArea { clicked => { root.select-encoder("Auto"); } }
                        }

                        Rectangle {
                            width: 70px; height: 32px;
                            background: root.active-encoder == "NVENC" ? #00ff66 : #0f172a; border-radius: 6px;
                            Text { text: "NVENC"; font-size: 9px; font-weight: 800; color: root.active-encoder == "NVENC" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                            TouchArea { clicked => { root.select-encoder("NVENC"); } }
                        }

                        Rectangle {
                            width: 70px; height: 32px;
                            background: root.active-encoder == "VA-API" ? #00ff66 : #0f172a; border-radius: 6px;
                            Text { text: "VA-API"; font-size: 9px; font-weight: 800; color: root.active-encoder == "VA-API" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                            TouchArea { clicked => { root.select-encoder("VA-API"); } }
                        }

                        Rectangle {
                            width: 70px; height: 32px;
                            background: root.active-encoder == "QSV" ? #00ff66 : #0f172a; border-radius: 6px;
                            Text { text: "QSV"; font-size: 9px; font-weight: 800; color: root.active-encoder == "QSV" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                            TouchArea { clicked => { root.select-encoder("QSV"); } }
                        }

                        Rectangle {
                            width: 80px; height: 32px;
                            background: root.active-encoder == "Software" ? #00ff66 : #0f172a; border-radius: 6px;
                            Text { text: "SOFTWARE"; font-size: 9px; font-weight: 800; color: root.active-encoder == "Software" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                            TouchArea { clicked => { root.select-encoder("Software"); } }
                        }
                    }
                }

                // Storage Tab
                if (root.active-tab == "storage") : VerticalLayout {
                    spacing: 10px;

                    Text { text: "Recording Export Path:"; font-size: 11px; font-weight: 700; color: #94a3b8; }

                    Rectangle {
                        height: 36px; background: #0f172a; border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: center;
                            Text { text: root.save-path; font-size: 10px; color: #38bdf8; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Footer Actions
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "Config stored at ~/.config/wolf-screen-recorder/config.json";
                font-size: 9px; color: #64748b; vertical-alignment: center;
            }

            Rectangle {
                width: 140px; height: 34px;
                background: #00ff66; border-radius: 8px;
                Text { text: "💾 SAVE & APPLY"; font-size: 11px; font-weight: 900; color: #000000; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                TouchArea {
                    clicked => {
                        root.save-settings();
                        root.close-settings();
                    }
                }
            }
        }
    }
}
