import { LineEdit } from "std-widgets.slint";

export component SettingsModal inherits Rectangle {
    width: 740px;
    height: 460px;
    background: #080c14;
    border-radius: 20px;
    border-width: 1.5px;
    border-color: #22d45e35;
    drop-shadow-blur: 36px;
    drop-shadow-color: #22d45e20;

    in-out property <string> active-tab: "general";
    in-out property <string> active-lang: "en";
    in-out property <string> active-encoder: "Auto";
    in-out property <string> save-path: "/home/user/Videos";
    in-out property <string> watermark-text: "WOLFITWAY";
    in-out property <string> watermark-logo-path: "";
    in-out property <string> watermark-position: "BottomRight";
    in-out property <bool> auto-watermark: true;
    in-out property <bool> cinematic-zoom: true;
    in-out property <bool> show-lang-dropdown: false;

    // Customizable Hotkey Properties
    in-out property <string> hotkey-record: "Super+Shift+R";
    in-out property <string> hotkey-snapshot: "Super+Shift+S";
    in-out property <string> hotkey-region: "Super+Shift+X";
    in-out property <string> hotkey-cancel: "Escape";

    callback close-settings();
    callback select-language(string);
    callback select-encoder(string);
    callback save-settings();
    callback upload-logo-dialog();
    callback clear-logo();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header Title Bar
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text { text: "⚙"; font-size: 16px; color: #38bdf8; vertical-alignment: center; }
                Text {
                    text: "PREFERENCES & SYSTEM CONFIGURATION";
                    font-size: 13px; font-weight: 900; color: #f8fafc;
                    vertical-alignment: center;
                }
            }

            close_btn := Rectangle {
                width: 32px; height: 32px;
                background: close_t.has-hover ? #ef4444 : #161e2e;
                border-radius: 16px;
                animate background { duration: 100ms; }

                Text {
                    text: "✕"; font-size: 13px; color: #f8fafc;
                    x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                }
                close_t := TouchArea { clicked => { root.close-settings(); } }
            }
        }

        Rectangle { height: 1px; background: #1e293b; }

        // Main Preferences Layout (Left Navigation Sidebar + Tab Content)
        HorizontalLayout {
            spacing: 14px;

            // Left Navigation Sidebar
            Rectangle {
                width: 160px;
                background: #0f1623;
                border-radius: 14px;
                border-width: 1px;
                border-color: #1e293b;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    alignment: start;

                    // Tab 1: General
                    t_gen := Rectangle {
                        height: 38px;
                        background: root.active-tab == "general" ? #22d45e : (t_gen_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; alignment: center;
                            Text {
                                text: "🌐 General & Lang";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tab == "general" ? #000000 : #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                        t_gen_t := TouchArea { clicked => { root.active-tab = "general"; } }
                    }

                    // Tab 2: Hardware
                    t_hw := Rectangle {
                        height: 38px;
                        background: root.active-tab == "hardware" ? #22d45e : (t_hw_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; alignment: center;
                            Text {
                                text: "⚡ GPU & Encoder";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tab == "hardware" ? #000000 : #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                        t_hw_t := TouchArea { clicked => { root.active-tab = "hardware"; } }
                    }

                    // Tab 3: Shortcuts
                    t_hk := Rectangle {
                        height: 38px;
                        background: root.active-tab == "shortcuts" ? #22d45e : (t_hk_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; alignment: center;
                            Text {
                                text: "⌨️ Shortcuts";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tab == "shortcuts" ? #000000 : #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                        t_hk_t := TouchArea { clicked => { root.active-tab = "shortcuts"; } }
                    }

                    // Tab 4: Storage
                    t_sto := Rectangle {
                        height: 38px;
                        background: root.active-tab == "storage" ? #22d45e : (t_sto_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; alignment: center;
                            Text {
                                text: "📁 Storage Paths";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tab == "storage" ? #000000 : #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                        t_sto_t := TouchArea { clicked => { root.active-tab = "storage"; } }
                    }

                    // Tab 5: Branding & Logo Watermark
                    t_brand := Rectangle {
                        height: 38px;
                        background: root.active-tab == "branding" ? #22d45e : (t_brand_t.has-hover ? #161e2e : transparent);
                        border-radius: 8px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; alignment: center;
                            Text {
                                text: "🎨 Branding Logo";
                                font-size: 10px; font-weight: 800;
                                color: root.active-tab == "branding" ? #000000 : #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                        t_brand_t := TouchArea { clicked => { root.active-tab = "branding"; } }
                    }
                }
            }

            // Tab Content Surface
            Rectangle {
                background: #0f1623;
                border-radius: 14px;
                border-width: 1px;
                border-color: #1e293b;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Tab 1: General Options
                    if (root.active-tab == "general") : VerticalLayout {
                        spacing: 12px;

                        Text { text: "INTERFACE LOCALIZATION"; font-size: 9px; font-weight: 900; color: #38bdf8; }

                        // Flag Selector Dropdown Box
                        Rectangle {
                            height: 38px;
                            background: #161e2e;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #3b82f6;

                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px;
                                alignment: space-between;

                                Text {
                                    text: root.active-lang == "ro" ? "🇷🇴 Română (RO)" :
                                          (root.active-lang == "es" ? "🇪🇸 Español (ES)" :
                                          (root.active-lang == "de" ? "🇩🇪 Deutsch (DE)" :
                                          (root.active-lang == "fr" ? "🇫🇷 Français (FR)" :
                                          (root.active-lang == "ja" ? "🇯🇵 日本語 (JA)" : "🇬🇧 English (EN)"))));
                                    font-size: 11px; font-weight: 800; color: #f8fafc;
                                    vertical-alignment: center;
                                }

                                Text { text: "▼"; font-size: 10px; color: #38bdf8; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.show-lang-dropdown = !root.show-lang-dropdown; } }
                        }

                        // Language Popover Menu
                        if (root.show-lang-dropdown) : Rectangle {
                            background: #161e2e;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #3b82f6;

                            VerticalLayout {
                                padding: 6px; spacing: 4px;

                                Rectangle {
                                    height: 28px; background: root.active-lang == "en" ? #3b82f6 : transparent; border-radius: 6px;
                                    HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇬🇧 English (EN)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.select-language("en"); root.show-lang-dropdown = false; } }
                                }
                                Rectangle {
                                    height: 28px; background: root.active-lang == "ro" ? #3b82f6 : transparent; border-radius: 6px;
                                    HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇷🇴 Română (RO)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.select-language("ro"); root.show-lang-dropdown = false; } }
                                }
                                Rectangle {
                                    height: 28px; background: root.active-lang == "es" ? #3b82f6 : transparent; border-radius: 6px;
                                    HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇪🇸 Español (ES)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.select-language("es"); root.show-lang-dropdown = false; } }
                                }
                                Rectangle {
                                    height: 28px; background: root.active-lang == "de" ? #3b82f6 : transparent; border-radius: 6px;
                                    HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇩🇪 Deutsch (DE)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.select-language("de"); root.show-lang-dropdown = false; } }
                                }
                                Rectangle {
                                    height: 28px; background: root.active-lang == "fr" ? #3b82f6 : transparent; border-radius: 6px;
                                    HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇫🇷 Français (FR)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.select-language("fr"); root.show-lang-dropdown = false; } }
                                }
                                Rectangle {
                                    height: 28px; background: root.active-lang == "ja" ? #3b82f6 : transparent; border-radius: 6px;
                                    HorizontalLayout { padding-left: 10px; alignment: center; Text { text: "🇯🇵 日本語 (JA)"; font-size: 10px; font-weight: 700; color: #fff; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.select-language("ja"); root.show-lang-dropdown = false; } }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1e293b; }

                        // Animated Pill Toggle Switch for Watermark
                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Automatic Showcase Watermark"; font-size: 11px; font-weight: 700; color: #f8fafc; }
                                Text { text: "Stamps WOLFITWAY branding on exported assets"; font-size: 9px; color: #cbd5e1; }
                            }

                            // Switch Toggle Pill
                            sw_pill := Rectangle {
                                width: 54px; height: 28px;
                                background: root.auto-watermark ? #22d45e : #1e293b;
                                border-radius: 14px;
                                animate background { duration: 100ms; }

                                Rectangle {
                                    width: 22px; height: 22px;
                                    background: #ffffff;
                                    border-radius: 11px;
                                    x: root.auto-watermark ? 28px : 3px;
                                    y: 3px;
                                    animate x { duration: 120ms; }
                                }
                                TouchArea { clicked => { root.auto-watermark = !root.auto-watermark; } }
                            }
                        }
                    }

                    // Tab 2: Hardware GPU & Encoding Options
                    if (root.active-tab == "hardware") : VerticalLayout {
                        spacing: 12px;

                        Text { text: "HARDWARE VIDEO ENCODER SELECTION"; font-size: 9px; font-weight: 900; color: #38bdf8; }

                        HorizontalLayout {
                            spacing: 8px;

                            Rectangle {
                                width: 74px; height: 36px;
                                background: root.active-encoder == "Auto" ? #22d45e : #161e2e;
                                border-radius: 8px;
                                Text { text: "⚡ AUTO"; font-size: 9px; font-weight: 900; color: root.active-encoder == "Auto" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.select-encoder("Auto"); } }
                            }

                            Rectangle {
                                width: 74px; height: 36px;
                                background: root.active-encoder == "NVENC" ? #22d45e : #161e2e;
                                border-radius: 8px;
                                Text { text: "NVENC"; font-size: 9px; font-weight: 900; color: root.active-encoder == "NVENC" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.select-encoder("NVENC"); } }
                            }

                            Rectangle {
                                width: 74px; height: 36px;
                                background: root.active-encoder == "VA-API" ? #22d45e : #161e2e;
                                border-radius: 8px;
                                Text { text: "VA-API"; font-size: 9px; font-weight: 900; color: root.active-encoder == "VA-API" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.select-encoder("VA-API"); } }
                            }

                            Rectangle {
                                width: 74px; height: 36px;
                                background: root.active-encoder == "QSV" ? #22d45e : #161e2e;
                                border-radius: 8px;
                                Text { text: "QSV"; font-size: 9px; font-weight: 900; color: root.active-encoder == "QSV" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.select-encoder("QSV"); } }
                            }

                            Rectangle {
                                width: 84px; height: 36px;
                                background: root.active-encoder == "Software" ? #22d45e : #161e2e;
                                border-radius: 8px;
                                Text { text: "SOFTWARE"; font-size: 9px; font-weight: 900; color: root.active-encoder == "Software" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.select-encoder("Software"); } }
                            }
                        }
                    }

                    // Tab 3: Customizable Shortcuts
                    if (root.active-tab == "shortcuts") : VerticalLayout {
                        spacing: 10px;

                        Text { text: "GLOBAL KEYBOARD SHORTCUTS"; font-size: 9px; font-weight: 900; color: #38bdf8; }
                        Text { text: "System-wide hotkeys active from any application:"; font-size: 9px; color: #cbd5e1; }

                        VerticalLayout {
                            spacing: 8px;

                            // Hotkey 1: Toggle Recording
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "🔴 Toggle Video Recording:"; font-size: 10px; font-weight: 700; color: #f8fafc; vertical-alignment: center; }
                                Rectangle {
                                    width: 160px; height: 32px;
                                    background: #161e2e; border-radius: 6px; border-width: 1px; border-color: #334155;
                                    LineEdit {
                                        text: root.hotkey-record;
                                        edited(t) => { root.hotkey-record = t; }
                                    }
                                }
                            }

                            // Hotkey 2: Instant Snapshot
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "📸 Instant Snapshot:"; font-size: 10px; font-weight: 700; color: #f8fafc; vertical-alignment: center; }
                                Rectangle {
                                    width: 160px; height: 32px;
                                    background: #161e2e; border-radius: 6px; border-width: 1px; border-color: #334155;
                                    LineEdit {
                                        text: root.hotkey-snapshot;
                                        edited(t) => { root.hotkey-snapshot = t; }
                                    }
                                }
                            }

                            // Hotkey 3: Region Select
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "✂️ Region Selector:"; font-size: 10px; font-weight: 700; color: #f8fafc; vertical-alignment: center; }
                                Rectangle {
                                    width: 160px; height: 32px;
                                    background: #161e2e; border-radius: 6px; border-width: 1px; border-color: #334155;
                                    LineEdit {
                                        text: root.hotkey-region;
                                        edited(t) => { root.hotkey-region = t; }
                                    }
                                }
                            }

                            // Hotkey 4: Cancel
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "✕ Cancel / Abort Modal:"; font-size: 10px; font-weight: 700; color: #f8fafc; vertical-alignment: center; }
                                Rectangle {
                                    width: 160px; height: 32px;
                                    background: #161e2e; border-radius: 6px; border-width: 1px; border-color: #334155;
                                    LineEdit {
                                        text: root.hotkey-cancel;
                                        edited(t) => { root.hotkey-cancel = t; }
                                    }
                                }
                            }
                        }
                    }

                    // Tab 4: Storage Paths
                    if (root.active-tab == "storage") : VerticalLayout {
                        spacing: 12px;

                        Text { text: "EXPORT & STORAGE DIRECTORY"; font-size: 9px; font-weight: 900; color: #38bdf8; }

                        Rectangle {
                            height: 40px; background: #161e2e; border-radius: 10px; border-width: 1px; border-color: #1e293b;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; alignment: center;
                                Text { text: root.save-path; font-size: 11px; color: #38bdf8; font-weight: 700; vertical-alignment: center; }
                            }
                        }
                    }

                    // Tab 5: Branding & Custom Logo Watermark
                    if (root.active-tab == "branding") : VerticalLayout {
                        spacing: 10px;

                        Text { text: "CUSTOM BRANDING & WATERMARK LOGO"; font-size: 9px; font-weight: 900; color: #38bdf8; }
                        Text { text: "Upload your own company/creator logo to watermark all snapshots & video recordings:"; font-size: 9px; color: #cbd5e1; }

                        // Logo File Upload Button & Badge
                        HorizontalLayout {
                            spacing: 8px;

                            btn_upload_logo := Rectangle {
                                height: 34px;
                                background: upload_l_t.has-hover ? #1d4ed8 : #2563eb;
                                border-radius: 8px;
                                animate background { duration: 100ms; }
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; alignment: center;
                                    Text { text: "📁 Browse Custom Logo..."; font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                                }
                                upload_l_t := TouchArea { clicked => { root.upload-logo-dialog(); } }
                            }

                            if (root.watermark-logo-path != "") : btn_clear_logo := Rectangle {
                                height: 34px;
                                background: clear_l_t.has-hover ? #dc2626 : #ef4444;
                                border-radius: 8px;
                                animate background { duration: 100ms; }
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; alignment: center;
                                    Text { text: "✕ Clear Logo"; font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                                }
                                clear_l_t := TouchArea { clicked => { root.clear-logo(); } }
                            }
                        }

                        // Logo Path Status Box
                        Rectangle {
                            height: 32px;
                            background: #161e2e;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #334155;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; alignment: center;
                                Text {
                                    text: root.watermark-logo-path == "" ? "No custom logo set (using text watermark banner)" : root.watermark-logo-path;
                                    font-size: 9px; font-weight: 700;
                                    color: root.watermark-logo-path == "" ? #94a3b8 : #22d45e;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Corner Placement Selector
                        Text { text: "CORNER PLACEMENT POSITION"; font-size: 9px; font-weight: 900; color: #38bdf8; }
                        HorizontalLayout {
                            spacing: 6px;

                            pos_br := Rectangle {
                                width: 95px; height: 30px;
                                background: root.watermark-position == "BottomRight" ? #22d45e : #161e2e;
                                border-radius: 6px;
                                Text { text: "Bottom-Right"; font-size: 9px; font-weight: 800; color: root.watermark-position == "BottomRight" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.watermark-position = "BottomRight"; } }
                            }

                            pos_bl := Rectangle {
                                width: 95px; height: 30px;
                                background: root.watermark-position == "BottomLeft" ? #22d45e : #161e2e;
                                border-radius: 6px;
                                Text { text: "Bottom-Left"; font-size: 9px; font-weight: 800; color: root.watermark-position == "BottomLeft" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.watermark-position = "BottomLeft"; } }
                            }

                            pos_tr := Rectangle {
                                width: 95px; height: 30px;
                                background: root.watermark-position == "TopRight" ? #22d45e : #161e2e;
                                border-radius: 6px;
                                Text { text: "Top-Right"; font-size: 9px; font-weight: 800; color: root.watermark-position == "TopRight" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.watermark-position = "TopRight"; } }
                            }

                            pos_tl := Rectangle {
                                width: 95px; height: 30px;
                                background: root.watermark-position == "TopLeft" ? #22d45e : #161e2e;
                                border-radius: 6px;
                                Text { text: "Top-Left"; font-size: 9px; font-weight: 800; color: root.watermark-position == "TopLeft" ? #000 : #fff; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                                TouchArea { clicked => { root.watermark-position = "TopLeft"; } }
                            }
                        }

                        // Text Watermark Banner Label
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Text Watermark Label:"; font-size: 10px; font-weight: 700; color: #f8fafc; vertical-alignment: center; }
                            Rectangle {
                                width: 160px; height: 30px;
                                background: #161e2e; border-radius: 6px; border-width: 1px; border-color: #334155;
                                LineEdit {
                                    text: root.watermark-text;
                                    edited(t) => { root.watermark-text = t; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bottom Footer Bar
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "Config stored at ~/.config/wolf-screen-recorder/config.json";
                font-size: 9px; color: #cbd5e1; vertical-alignment: center;
            }

            save_btn := Rectangle {
                width: 150px; height: 36px;
                background: save_t.has-hover ? #16a34a : #22d45e;
                border-radius: 10px;
                animate background { duration: 100ms; }

                Text { text: "💾 SAVE & APPLY"; font-size: 11px; font-weight: 900; color: #000000; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                save_t := TouchArea {
                    clicked => {
                        root.save-settings();
                        root.close-settings();
                    }
                }
            }
        }
    }
}
