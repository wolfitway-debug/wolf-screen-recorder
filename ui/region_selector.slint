export component RegionSelectorWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: true;

    in-out property <int> selection-x: 0;
    in-out property <int> selection-y: 0;
    in-out property <int> selection-w: 0;
    in-out property <int> selection-h: 0;
    in-out property <bool> is-selecting: false;

    callback selection-confirmed(int, int, int, int);
    callback selection-cancelled();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000075;

        // Top Helper Banner
        Rectangle {
            x: (parent.width - self.width)/2;
            y: 30px;
            height: 36px;
            background: #080c14e0;
            border-radius: 18px;
            border-width: 1.5px;
            border-color: #22d45e;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;

            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                spacing: 8px; alignment: center;

                Text { text: "✂️"; font-size: 14px; vertical-alignment: center; }
                Text {
                    text: "Drag to select capture region · Press ESC to cancel";
                    font-size: 11px; font-weight: 800; color: #f8fafc;
                    vertical-alignment: center;
                }
            }
        }

        TouchArea {
            property <int> start-x;
            property <int> start-y;

            mouse-cursor: MouseCursor.crosshair;

            pointer-event(event) => {
                if (event.button == PointerEventButton.left) {
                    if (event.kind == PointerEventKind.down) {
                        self.start-x = self.mouse-x / 1px;
                        self.start-y = self.mouse-y / 1px;
                        root.selection-x = self.start-x;
                        root.selection-y = self.start-y;
                        root.selection-w = 0;
                        root.selection-h = 0;
                        root.is-selecting = true;
                    } else if (event.kind == PointerEventKind.up) {
                        let end-x = self.mouse-x / 1px;
                        let end-y = self.mouse-y / 1px;

                        let final-x = self.start-x.min(end-x);
                        let final-y = self.start-y.min(end-y);
                        let final-w = (end-x - self.start-x).abs();
                        let final-h = (end-y - self.start-y).abs();

                        if (final-w > 20 && final-h > 20) {
                            root.selection-confirmed(final-x, final-y, final-w, final-h);
                        } else {
                            root.selection-cancelled();
                        }
                    }
                }
            }

            moved => {
                if (root.is-selecting) {
                    let cur-x = self.mouse-x / 1px;
                    let cur-y = self.mouse-y / 1px;

                    let min-x = self.start-x.min(cur-x);
                    let min-y = self.start-y.min(cur-y);
                    let w = (cur-x - self.start-x).abs();
                    let h = (cur-y - self.start-y).abs();

                    root.selection-x = min-x;
                    root.selection-y = min-y;
                    root.selection-w = w;
                    root.selection-h = h;
                }
            }
        }

        // Rubber-Band Selection Rectangle Overlay
        if (root.selection-w > 0 && root.selection-h > 0) : Rectangle {
            x: root.selection-x * 1px;
            y: root.selection-y * 1px;
            width: root.selection-w * 1px;
            height: root.selection-h * 1px;
            background: #22d45e1a;
            border-width: 2px;
            border-color: #22d45e;

            // Corner Handles
            Rectangle { width: 8px; height: 8px; background: #22d45e; x: -4px; y: -4px; }
            Rectangle { width: 8px; height: 8px; background: #22d45e; x: parent.width - 4px; y: -4px; }
            Rectangle { width: 8px; height: 8px; background: #22d45e; x: -4px; y: parent.height - 4px; }
            Rectangle { width: 8px; height: 8px; background: #22d45e; x: parent.width - 4px; y: parent.height - 4px; }

            // High-Contrast Dimension Feedback Badge
            Rectangle {
                x: (parent.width - self.width)/2;
                y: (parent.height - self.height)/2;
                height: 28px;
                background: #080c14f0;
                border-radius: 14px;
                border-width: 1.5px;
                border-color: #22d45e;

                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; alignment: center;
                    Text {
                        text: "📐 " + root.selection-w + " × " + root.selection-h + " px";
                        font-size: 11px; font-weight: 900; color: #22d45e;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
